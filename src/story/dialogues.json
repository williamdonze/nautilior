                {
                  "text": "Je ne comprends pas.",
                  "next": "other"
                }
              ]
            },
            "other": {
              "text": "Ce qui remontera de l'autre côté, ce ne sera pas toi.",
              "next": "c"
            },
            "c": {
              "text": "Ferme-la. Reste ici, où on peut te soigner. Je te le demande. (Sa voix se casse.) Je t'en supplie.",
              "end": true
            }
